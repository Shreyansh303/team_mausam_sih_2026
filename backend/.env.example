# Team Mausam backend — copy to .env and edit. No keys are required for the default demo setup.

DEMO_MODE=1
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Auth / admin (A2/A3)
ADMIN_KEY=mausam-admin
JWT_SECRET=change-me-in-production
JWT_EXPIRE_DAYS=30

# Storage
DATABASE_URL=sqlite:///./data/mausam.db
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Optional upstream keys (features degrade to estimates when empty)
DATA_GOV_IN_KEY=
TOMTOM_KEY=

# IMD (needs IP whitelisting — see README)
IMD_BASE_URL=https://mausam.imd.gov.in/api
IMD_ENABLED=1

# Demo controls
DEFAULT_SCENARIO=live

# HTTP / CORS
CORS_ORIGINS=*
HTTP_TIMEOUT_S=8

# Cache TTLs (seconds)
CACHE_TTL_FORECAST=600
CACHE_TTL_AIR=900
CACHE_TTL_MARINE=1800
CACHE_TTL_GEOCODE=86400
CACHE_TTL_RADAR=300
CACHE_TTL_IMD=600
CACHE_TTL_SNAPSHOT=300
