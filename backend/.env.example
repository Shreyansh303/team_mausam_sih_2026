# Team Mausam backend — copy to .env and edit. No keys are required for the default demo setup.

DEMO_MODE=1
LOG_LEVEL=INFO
APP_VERSION=0.1.0

# Auth / admin (A2/A3)
ADMIN_KEY=mausam-admin
JWT_SECRET=mausam-dev-secret-change-me-in-production
JWT_EXPIRE_DAYS=30

# Storage
DATABASE_URL=sqlite:///./data/mausam.db
# REDIS_URL=redis://localhost:6379/0
REDIS_URL=

# Optional upstream keys (features degrade to estimates when empty)
DATA_GOV_IN_KEY=
TOMTOM_KEY=

# Push notifications (S3 — optional; see docs/09_PUSH_NOTIFICATIONS.md).
# Empty = the "noop" transport: device registration still works and every intended send is
# logged, nothing leaves the process. Set BOTH to deliver through FCM HTTP v1. The service
# account JSON is a SECRET — keep it outside the repo and never commit it.
FCM_SERVICE_ACCOUNT_FILE=
FCM_PROJECT_ID=

# IMD (needs IP whitelisting — see README)
IMD_BASE_URL=https://mausam.imd.gov.in/api
IMD_ENABLED=1

# Personalization engine (S1). 0 = the deterministic v1 ranker only (default and fallback).
# 1 = also blend the bounded learned term from the v2 logistic-regression ranker; it can
# move a card by at most +/-0.1 and never reorders anything against a pinned warning.
ENGINE_ML=0

# Demo controls
DEFAULT_SCENARIO=live

# HTTP / CORS
CORS_ORIGINS=*
HTTP_TIMEOUT_S=8

# Cache TTLs (seconds)
CACHE_TTL_FORECAST=600
CACHE_TTL_AIR=900
CACHE_TTL_MARINE=1800
CACHE_TTL_GEOCODE=86400
CACHE_TTL_RADAR=300
CACHE_TTL_IMD=600
CACHE_TTL_SNAPSHOT=300
