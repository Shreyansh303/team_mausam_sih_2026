<?xml version="1.0" encoding="utf-8"?>
<!-- Chrome for the home-screen widget (docs/06 §Home-screen widget → Strings).

     The widget draws with RemoteViews, outside the Flutter engine, so it cannot reach the ARBs
     in lib/l10n. Only its own chrome lives here; the weather content itself arrives already
     localized from the backend (docs/04 `lang`). `values-hi/` is the Hindi copy.

     docs/00_VISION.md principle 8: the name is the Team Mausam prototype name, never
     IMD's. -->
<resources>
    <string name="widget_label">Mausam Personalized</string>
    <string name="widget_description">Now, plus the one thing that matters most today.</string>

    <!-- Shown when there is no snapshot yet, or when the one we have is over six hours old. -->
    <string name="widget_open_to_refresh">Open Mausam to refresh</string>

    <!-- docs/00_VISION.md principle 6 (honest data) — modelled data is labelled, here as well
         as in the app. -->
    <string name="widget_estimated">Estimated</string>

    <string name="widget_age_now">just now</string>
    <string name="widget_age_minutes">%1$d min ago</string>
    <string name="widget_age_hours">%1$d h ago</string>
    <string name="widget_age_days">%1$d d ago</string>

    <!-- Sample content for the Android 12+ widget picker preview only. -->
    <string name="widget_preview_temp">31°</string>
    <string name="widget_preview_condition">Thunderstorm</string>
    <string name="widget_preview_location">New Delhi</string>
    <string name="widget_preview_age">6 min ago</string>
    <string name="widget_preview_pinned_title">Weather warnings</string>
    <string name="widget_preview_pinned_insight">Orange warning: thunderstorm with lightning</string>
</resources>
